# ── Mongo ──────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017
MONGO_DB=ishchibormi

# ── Backend (Go API) ───────────────────────────────────
HTTP_ADDR=:8080
# APP_ENV=production qo'yilganda zaif standart sirlar bilan ishga tushish
# bloklanadi (server xato bilan to'xtaydi). Dev uchun bo'sh/"dev" qoldiring.
APP_ENV=dev
# Klient IP'sini (rate-limit uchun) qanday aniqlashni belgilaydi.
#  - PRODUCTION'da (nginx/caddy/ALB kabi reverse-proxy ortida, TLS bilan):
#    "true" QILING. Aks holda backend har bir so'rov uchun proksi IP'sini ko'radi
#    → BARCHA foydalanuvchilar bitta rate-limit bucket'ni bo'lishadi (haqiqiy
#    userlar 429 oladi, brute-force himoyasi esa buziladi).
#  - LOKAL/to'g'ridan-to'g'ri (proksisiz): "false" qoldiring, aks holda
#    X-Forwarded-For soxtalashtirilib rate-limit chetlab o'tiladi.
# docker-compose (prod yo'li) buni standart "true" qiladi — pastga qarang.
TRUST_PROXY_HEADERS=false
# Oldingizda nechta reverse-proxy turganini bildiradi (TRUST_PROXY_HEADERS=true
# bo'lgandagina o'qiladi). Proksilar X-Forwarded-For'ga o'z ustiga QO'SHADI,
# shuning uchun haqiqiy mijoz — o'ngdan sanaganda shu raqamdagi element.
#   1 = deploy/Caddyfile sxemasi (faqat Caddy)  ← standart
#   2 = Caddy oldida CDN bo'lsa (masalan Cloudflare)
# XATO QIYMAT XAVFLI: kichik qo'ysangiz backend mijoz yozgan (soxta) elementni
# o'qiydi va rate-limit umuman ishlamay qoladi; katta qo'ysangiz hamma
# foydalanuvchi bitta bucket'ga tushib 429 oladi.
TRUSTED_PROXY_HOPS=1
# MUHIM: production'da bu sirlarni kuchli, tasodifiy (>=32 belgi) qiymatlarga
# almashtiring va ikkalasi BIR-BIRIDAN FARQ qilsin. Masalan:
#   openssl rand -hex 32
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
# Access token muddati (daqiqada). 4320 = 72 soat (3 kun). Mobil ilova refresh
# oqimi bilan o'zi yangilaydi; web frontend refresh tokenni ataylab saqlamaydi,
# shuning uchun web seansi shu qiymat bilan belgilanadi.
JWT_ACCESS_TTL_MIN=4320
# Privileged admin sessions are short-lived and also revocable server-side.
JWT_ADMIN_TTL_MIN=30
JWT_REFRESH_TTL_HRS=720
# Admin sessiyasi qancha vaqt FOYDALANILMASA yopiladi (soatda). 72 = 3 kun.
#
# JWT_ADMIN_TTL_MIN dan farqi bor va ikkalasi ham kerak:
#   * JWT_ADMIN_TTL_MIN — access token umri. Qisqa bo'lgani yaxshi:
#     o'g'irlangan token tez o'ladi. Uni klient jimgina yangilab turadi,
#     shuning uchun admin buni sezmaydi.
#   * ADMIN_IDLE_TTL_HOURS — "qachongacha parol va 2FA qayta so'ralmaydi".
#     Har bir so'rov oynani boshidan boshlaydi.
#
# Oyna HISOB bo'yicha yagona: veb panel va mobil admin ilovasi uni bo'lishadi.
# Bittasida ishlash ikkinchisini ham tirik saqlaydi; uch kun ikkalasiga ham
# tegilmasa — ikkalasidan birdan chiqariladi.
ADMIN_IDLE_TTL_HOURS=72
# Production'da frontend domeningizni yozing, masalan: https://ishchibormi.uz
# (bir nechta bo'lsa vergul bilan). Noto'g'ri bo'lsa brauzer API so'rovlarini
# CORS sababli bloklaydi va sahifa "ishlamayapti"dek ko'rinadi.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ADMIN_SEED_USER=admin
# Production'da standart paroldan boshqa, kuchli parol qo'ying.
ADMIN_SEED_PASS=Admin123!

# Internal shared secret backend ⇄ bot (HMAC) and bot status callbacks
BOT_SHARED_SECRET=change-me-shared

# OTP behaviour
OTP_TTL_SECONDS=180
OTP_LENGTH=6
# In dev mode the OTP is also returned in the API response body / log line
# so you can complete login without an actual Telegram bot token.
# MUHIM: production'da ALBATTA false bo'lsin — aks holda tasdiqlash kodlari
# API javobida oshkor bo'ladi (akkauntni egallab olish xavfi).
OTP_DEV_RETURN=false

# ── Google Play review login ───────────────────────────
# Play reviewer'i Telegram boti orqali kira olmaydi (uning Telegram hisobi ham,
# O'zbekiston raqami ham yo'q), lekin Google App Access ishlaydigan kredensial
# talab qiladi. Yoqilganda /auth/otp/verify BITTA qo'shimcha kodni qabul qiladi
# va uni BITTA oldindan yaratilgan, cheklangan demo hisobga bog'laydi.
#
# Mexanizm: backend/internal/auth/review.go
# Boshqaruv: docker compose exec backend /app/reviewaccount open|close|status
#
# MUHIM QOIDALAR:
#   - Kod mobil ilovaga HECH QACHON kirmaydi — reviewer uni oddiy 6 xonali OTP
#     maydoniga qo'lda kiritadi. APK'da hech narsa yo'q.
#   - REVIEW_LOGIN_ENABLED review davridan tashqari HAR DOIM false. Deploy
#     pipeline uni har safar false qilib qayta o'rnatadi.
#   - EXPIRES_AT majburiy: oyna o'zi yopiladi. Muddat o'tsa login inert bo'ladi
#     (server yiqilmaydi). Maksimum 30 kun, tavsiya 7 kun.
#   - Tasdiqlangach: ENABLED=false QILING **VA** hisobni bloklang
#     (`reviewaccount close`) — ikkalasi ham shart.
#   - Har submission uchun YANGI kod. Kod hech qachon qayta ishlatilmaydi.
REVIEW_LOGIN_ENABLED=false
REVIEW_LOGIN_CODE=
REVIEW_LOGIN_EXPIRES_AT=
REVIEW_LOGIN_USER_ID=

# ── Telegram bot ───────────────────────────────────────
# Bot displey nomini @BotFather -> /setname orqali "Ishchi Bormi" qilib qo'ying.
# (Bu nom kod orqali emas, BotFather sozlamasidan o'rnatiladi.)
# Bot yuborgan tasdiqlash kodi Markdown `code` formatida bo'lgani uchun
# Telegramda ustiga bossangiz avtomatik nusxalanadi.
# Shu OTP bot orqali ish/ariza bildirishnomalari ham yuboriladi.
# Admin/dasturchi xabarlari Telegram'ga uzatilmaydi.
TELEGRAM_BOT_TOKEN=
# Bot @username (boshida @ SIZ, faqat nom). Login tugmasidagi t.me havolasi
# shundan quriladi — bo'sh qoldirilsa tugma botga o'tmaydi.
TELEGRAM_BOT_USERNAME=Ishchibormibot

# Yangi e'lonlar bot ADMINISTRATOR bo'lgan BARCHA kanallarga chiqadi.
# Hech qanday sozlama shart emas: botni kanalingizga admin qilib qo'shing va
# "Post Messages" huquqini bering — keyingi e'londan boshlab kanal e'lonlarni
# oladi. Kanallar reyestrini bot `my_chat_member` update'lari orqali yuritadi.
#
# Quyidagi kalit IXTIYORIY va faqat BIR holat uchun: bot allaqachon a'zo
# bo'lgan kanal. Telegram mavjud a'zolik uchun update yubormaydi, ya'ni
# bunday kanal o'z-o'zidan reyestrga tushmaydi. Kalit qo'yilsa API ishga
# tushganda uni bir marta qayd etadi. Yangi kanallar uchun kerak emas.
# Kanalni to'xtatish: botni administratorlardan chiqaring, yoki bazada
# telegram_channels dagi yozuvga status: "blocked" qo'ying (kod uni hech
# qachon qayta yoqmaydi).
# Shaxsiy bot chatlariga e'lon hech qachon yuborilmaydi.
TELEGRAM_JOBS_CHANNEL_ID=

# Bot e'lon yaratish uchun shu API origin'iga ulanadi. Docker Compose buni
# http://backend:8080 bilan almashtiradi. BOT_SHARED_SECRET API va bot uchun
# bir xil, tasodifiy va kamida 32 belgidan iborat bo'lishi shart.
BOT_API_BASE_URL=http://127.0.0.1:8080
# Telegram bildirishnomalaridagi web havolalar. Lokal: http://127.0.0.1:3000
# Telegram inline tugmalarda localhost'ni rad etadi.
WEB_BASE_URL=https://ishchibormi.uz
# E'lon berish tugmasi ochadigan Telegram Mini App (HTTPS majburiy).
# Lokal test: vaqtinchalik tunnel manzili + /miniapp/post.
TELEGRAM_MINIAPP_URL=https://ishchibormi.uz/miniapp/post
# Faqat Next.js serveri ishlatadi; mobil brauzer bu manzilga ulanmaydi.
# Docker Compose: http://backend:8080.
MINIAPP_API_BASE_URL=http://127.0.0.1:8080

# ── Kontent moderatsiyasi (Google Gemini) ──────────────
# E'lon matni va rasmi Gemini orqali tekshiriladi.
# Kalitni https://aistudio.google.com/apikey dan oling.
#
# MUHIM: bu kalit FAQAT backendda qoladi. Flutter/web klientga hech qachon
# yuborilmaydi va javoblarda ham, loglarda ham ko'rinmaydi.
# Bo'sh qoldirilsa moderatsiya jimgina o'chiq: /api/moderation/* 503 qaytaradi,
# API'ning qolgan qismi to'liq ishlayveradi.
GEMINI_API_KEY=
# Model. Bo'sh = gemini-3.5-flash-lite (multimodal, eng tez/arzon variant).
GEMINI_MODEL=
# Gemini API ildizi. Faqat test/proksi uchun; bo'sh = rasmiy manzil.
GEMINI_BASE_URL=
# Bitta moderatsiya chaqiruvi uchun timeout (soniya).
GEMINI_TIMEOUT_SECONDS=20

# ── Xatolik sababini AI orqali aniqlash ─────────────────────────────────
# Admin panel · "3.12.1 · Xatolik — batafsil" ekranidagi "Sababini aniqla".
# Niqoblangan kontekst matni Gemini'ga yuboriladi va ildiz-sabab xulosasi
# guruhga saqlanadi.
#
# NEGA ALOHIDA KALIT: moderatsiya foydalanuvchi oqimida (har e'lon), tahlil
# esa admin tugmasida ishlaydi. Kvota tugaganda biri ikkinchisini o'ldirib
# qo'ymasligi kerak. Bo'sh qoldirilsa GEMINI_API_KEY ishlatiladi; u ham
# bo'sh bo'lsa tugma 503 qaytaradi, panelning qolgani ishlayveradi.
ERROR_AI_API_KEY=
# Model. Bo'sh = gemini-3.6-flash. DIQQAT: 3.x modellarda "thinking" majburiy
# yoqiq — kod thinkingLevel="low" yuboradi, aks holda model butun javob
# byudjetini ichki fikrlashga sarflab, matnsiz MAX_TOKENS qaytaradi.
ERROR_AI_MODEL=
# Bitta tahlil chaqiruvi uchun timeout (soniya). Server WriteTimeout 60 s —
# bu qiymat undan sezilarli kichik bo'lishi shart.
ERROR_AI_TIMEOUT_SECONDS=40

MODERATION_MAX_IMAGE_MB=8
# Necha marta nomaqbul kontent yuborilgach hisob bloklanadi.
# E'lon, profil matni ("Men haqimda") va profil rasmi BITTA umumiy hisobga
# qo'shiladi. Hisob TELEFON raqami bo'yicha yuritiladi — hisobni o'chirib
# qayta ro'yxatdan o'tish jazoni nolga qaytarmaydi.
MODERATION_STRIKE_LIMIT=3
# Avtomatik blok muddati (kun). 730 = 2 yil.
MODERATION_BAN_DAYS=730
# Foydalanuvchi kiritgan matn avtomatik tekshirilsinmi. Qamrovi:
#   POST/PATCH /api/elons    — e'lon matni va rasmlari
#   PATCH      /api/me       — ism, familiya, bio, ko'nikmalar
#   POST       /api/feedback — taklif/shikoyat mavzusi va matni
# false (standart) = mavjud oqimlar umuman o'zgarmaydi.
# true qilinsa GEMINI_API_KEY ham majburiy bo'ladi.
MODERATION_ENFORCE=false
# Moderatsiya xizmati ishlamay qolsa nima qilinsin:
#   true  = e'lon rad etiladi (fail-closed) — tekshirilmagan e'lon ommaga chiqmaydi;
#   false = e'lon tekshirilmasdan o'tkaziladi (fail-open), xato logga yoziladi.
# BO'SH QOLDIRING: standart qiymat muhitga qarab tanlanadi —
#   production => true (fail-closed),  dev => false (fail-open).
# Productionda ataylab false qilinsa boot'da ogohlantirish yoziladi.
MODERATION_FAIL_CLOSED=

# ── Mobil push (FCM) ───────────────────────────────────
# Firebase service-account JSON fayl yo'li (konteyner ICHIDAGI yo'l).
# Olish: Firebase Console -> Project Settings -> Service accounts ->
# "Generate new private key". Faylni serverda ./secrets/ ostiga qo'ying va
# docker-compose.yml dagi backend volume/environment izohlarini oching.
# Bo'sh qoldirilsa mobil push jimgina o'chiq — API to'liq ishlayveradi.
# MUHIM: bu fayl sir — git'ga qo'shilmaydi (secrets/ .gitignore'da).
FCM_CREDENTIALS_FILE=

# ── AWS S3 (file uploads) ───────────────────────────────
# Bo'sh qoldirilsa, fayl yuklash funksiyalari 503 qaytaradi.
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
# Bo'sh qoldirilsa avtomatik tuziladi: https://<bucket>.s3.<region>.amazonaws.com
AWS_S3_PUBLIC_BASE_URL=

# ── Lokal disk saqlash (S3 sozlanmagan holat) ──────────────
# AWS_S3_BUCKET bo'sh bo'lsa backend rasmlarni shu papkada saqlaydi va ularni
# o'zi /uploads ostida tarqatadi. Prod serverda (Hetzner) standart yo'l shu:
# papka `uploads` docker volume'iga bog'langan (docker-compose.yml).
UPLOAD_DIR=./data/uploads
# Rasm URL'lari shu manzildan quriladi. MUHIM: production'da (APP_ENV=production
# va S3 yo'q bo'lsa) bu ALBATTA HTTPS bo'lishi kerak — aks holda API ishga
# tushmaydi (config.go mustValidate). Domeningizni yozing:
#   UPLOAD_PUBLIC_BASE=https://ishchibormi.uz/uploads
# Reverse-proxy (deploy/Caddyfile) /uploads/* ni backend'ga yo'naltiradi.
UPLOAD_PUBLIC_BASE=http://localhost:8080/uploads

# ── Hisobni o'chirish / saqlash muddati ────────────────
# O'chirilgan hisob "yumshoq o'chirilgan" holatda necha kun turadi. Muddat
# tugagach hisob va unga bog'liq HAMMA yozuv (e'lonlar, arizalar,
# bildirishnomalar, shikoyatlar, fikr-mulohaza, rasmlar, arxivlangan
# telefon/Telegram ID) bazadan butunlay o'chiriladi. Backend buni har 6 soatda
# avtomatik bajaradi — internal/account/retention.go.
#
# DIQQAT: bu raqam foydalanuvchiga aytiladigan muddat bilan BIR XIL bo'lishi
# shart (frontend/lib/retention.ts → /delete-account va /maxfiylik-siyosati).
# Mos kelmasa Google Play siyosati buziladi: kod bajarmaydigan va'da berilgan
# bo'ladi. Bo'sh yoki 0/manfiy qoldirilsa 90 kun qo'llanadi.
ACCOUNT_RETENTION_DAYS=90

# ── Frontend ───────────────────────────────────────────
# MUHIM: bu qiymatlar frontend IMAGE QURILAYOTGANDA kodga yoziladi (build arg).
# Shuning uchun productionda `docker compose up --build` dan OLDIN to'g'ri
# qo'yilishi shart. Foydalanuvchi brauzeri shu manzilga so'rov yuboradi —
# localhost qolib ketsa hech narsa ishlamaydi. Masalan (API shu domenda
# /api proxy bilan bo'lsa):
#   NEXT_PUBLIC_API_BASE=https://ishchibormi.uz
#   NEXT_PUBLIC_WS_BASE=wss://ishchibormi.uz
NEXT_PUBLIC_API_BASE=http://localhost:8080
NEXT_PUBLIC_WS_BASE=ws://localhost:8080

# ── Boshqaruv (admin) paneli qaysi xostda ────────────────────────────────────
# Masalan: ADMIN_PANEL_HOST=boshqaruv-xxxxxx.ishchibormi.uz
#
# Qiymat berilsa Next.js middleware'i shu xostdan tashqarida /admin ni 404
# qiladi, o'sha xostda esa faqat panelni ko'rsatadi (apps/web/middleware.ts).
# Bo'sh qolsa hech narsa o'zgarmaydi — panel eski joyida (/admin) ochiladi;
# lokal ishlash uchun shu ma'qul.
#
# ATAYLAB NEXT_PUBLIC_ EMAS: bitta build ommaviy saytga ham xizmat qiladi va
# u prefiks bilan nom brauzerdagi JS ichiga tushib, maxfiy bo'lmay qolardi.
#
# Xost nomining O'ZI Caddy uchun ham kerak, lekin u boshqa joydan o'qiydi —
# /etc/caddy/panel.env (deploy/README.md ga qarang). Ikkalasi bir xil
# bo'lishi SHART.
#
# Qiymat runtime'da o'qiladi, ya'ni o'zgarsa konteynerni qayta ishga tushirish
# (`docker compose up -d frontend`) kifoya — qayta build shart emas.
ADMIN_PANEL_HOST=
